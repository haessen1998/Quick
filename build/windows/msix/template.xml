<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="quick.exe"
        Arguments=""
        InstallLocation="C:\Program Files\My Company\Quick">
    </Installer>
    <PackageInformation
        PackageName="Quick"
        PackageDisplayName="Quick"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="0.3.3.0"
        PackageDescription="A Quick application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="vip.haessen.quick"
                Description="A Quick application"
                DisplayName="Quick"
                ExecutableName="quick.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Quick</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>A Quick application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="quick.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
